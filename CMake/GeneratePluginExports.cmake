#Writes a source file which exports the Squirrel API from avCore.dll, so a native plugin can link
#avCore.lib for it rather than embedding its own copy of Squirrel.
#
#CMAKE_WINDOWS_EXPORT_ALL_SYMBOLS only covers avCore's own object files, never the static
#libraries linked into it, and a .def file can't use wildcards. So the names are read from the
#libraries themselves, which also keeps the list to symbols this build of Squirrel defines.
#
#Run with cmake -P, passing DUMPBIN, OUTPUT and LIBS (a | separated list of static libraries).

string(REPLACE "|" ";" libs "${LIBS}")

set(exports "")
foreach(lib ${libs})
    execute_process(
        COMMAND "${DUMPBIN}" /NOLOGO /LINKERMEMBER:1 "${lib}"
        OUTPUT_VARIABLE dump
        RESULT_VARIABLE result
    )
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "dumpbin failed to read the symbols of ${lib}")
    endif()

    string(REGEX MATCHALL "[ \t](sq_[A-Za-z0-9_]+|sqstd_[A-Za-z0-9_]+)[\r\n]" found "${dump}")
    foreach(symbol ${found})
        string(STRIP "${symbol}" symbol)
        list(APPEND exports "${symbol}")
    endforeach()
endforeach()

list(REMOVE_DUPLICATES exports)
list(SORT exports)
list(LENGTH exports count)
if(count EQUAL 0)
    message(FATAL_ERROR "No Squirrel symbols were found to export in ${LIBS}")
endif()

set(content "//Generated by CMake/GeneratePluginExports.cmake. Do not edit.\n")
foreach(symbol ${exports})
    string(APPEND content "#pragma comment(linker, \"/EXPORT:${symbol}\")\n")
endforeach()

#Only rewrite on a change, so an unchanged list doesn't force avCore to relink.
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
endif()
if(NOT "${previous}" STREQUAL "${content}")
    file(WRITE "${OUTPUT}" "${content}")
endif()
message(STATUS "Exporting ${count} Squirrel symbols from avCore for plugins")
